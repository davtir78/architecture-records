{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference architecture front matter",
  "type": "object",
  "required": ["owner", "status", "version", "date"],
  "properties": {
    "template": { "const": "reference-architecture" },
    "owner": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "in review", "endorsed"] },
    "version": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "applies-to": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
